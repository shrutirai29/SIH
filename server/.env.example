# Copy to `server/.env` and fill in the key. `.env` is gitignored; this file is not,
# so never put a real key in here.
#
#   cp server/.env.example server/.env
#
# Read by `python -m mantri.evals` (the eval CLI). The FastAPI server still reads the
# shell environment - see QUICKSTART.md's `setx` block - because loading a .env at
# import time would also load it inside pytest, and one test makes a real, paid call
# whenever a key is present.

# From https://openrouter.ai/keys. Treat it like a password: anyone holding it can
# spend your credit. If it ever appears in a terminal you paste from, rotate it.
PRAHARI_LLM_API_KEY=

# The model the eval suite and the server plan with.
PRAHARI_LLM_MODEL=qwen/qwen2.5-vl-72b-instruct

PRAHARI_LLM_BASE_URL=https://openrouter.ai/api/v1

# Optional. The cheaper text-only model MANTRI routes to when the page description is
# complete enough to act on without a screenshot (ticket G4). Left unset, the router
# falls back to the vision model above: correct, just without the saving - and with
# nothing to escalate to when a plan fails to ground.
# PRAHARI_LLM_TEXT_MODEL=
